APP_ENV=development

DB_HOST=localhost
# Opcional: 3306 por defecto. Con DB_HOST=localhost, PHP entra por el socket y no usa el puerto.
DB_PORT=3306
DB_NAME=crisenri_premiumfitness
DB_USER=root
DB_PASS=

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=https://premiumfitness.nutramerican.com,https://premiumfitness-admin.nutramerican.com

# JWT y sesiones (spec seguridad/01)
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret-of-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_DAY=10
# relax = envío real (obligatorio en producción) | log = desarrollo, escribe en logs/sms-dev.log
SMS_DRIVER=relax

# App web: base de los enlaces del entrenador (/r/c/<id> y /r/t/<id>)
WEB_APP_URL=https://premiumfitness.nutramerican.com

# Constantes de negocio (docs/reglas-de-negocio.md)
CLIENT_DISCOUNT_PERCENTAGE=10
TRAINER_DISCOUNT_PERCENTAGE=25
CLIENT_PURCHASE_POINTS_PERCENTAGE=5
TRAINER_COMMISSION_PERCENTAGE=15
TRAINER_REFERRAL_POINTS=50000
POINTS_EXPIRATION_MONTHS=6
COMMISSION_CONVERSION_PERCENTAGE=50

# Flete por ciudad (spec backend/03, P-03): los valores de la tienda de radical. La tarifa sale de
# tb_servientrega de la intranet, desde la bodega más barata de SHIPPING_ORIGINS.
SHIPPING_ORIGINS=barranquilla,bogota,bucaros,cali,cucuta,medallo
SHIPPING_MINIMUM_FEE=9900
# Ciudades principales y Bogotá: valor fijo y envío gratis desde su mínimo (lo pagado por los productos)
SHIPPING_MAIN_CITIES=BARRANQUILLA,BUCARAMANGA,CALI,CUCUTA,MEDELLIN,PEREIRA
SHIPPING_MAIN_CITIES_FEE=9900
SHIPPING_MAIN_CITIES_FREE_FROM=1000000
SHIPPING_BOGOTA_FEE=11300
SHIPPING_BOGOTA_FREE_FROM=170000
# Fórmula de la tarifa, la del webservice /fletes del sitio de Nutramerican: tipo 3 y 4, valor fijo;
# tipo 1 y 2, costo + HANDLING_PERCENTAGE del valor declarado + SURCHARGE, y FLOOR si no pasa de FLOOR_LIMIT.
SHIPPING_RATE_TYPE3_FEE=4900
SHIPPING_RATE_TYPE4_FEE=11400
SHIPPING_RATE_DECLARED_VALUE=300000
SHIPPING_RATE_HANDLING_PERCENTAGE=0.5
SHIPPING_RATE_SURCHARGE=2000
SHIPPING_RATE_FLOOR_LIMIT=11000
SHIPPING_RATE_FLOOR=12500

# Catálogo: tabla de productos de la intranet, solo lectura (spec catalogo/01)
INTRANET_DB_NAME=crisenri_intranet
PRODUCT_CATALOG_CACHE_SECONDS=600

# IVA (spec catalogo/01): por línea, al comprar. 103040 = Nutra C
VAT_PERCENTAGE=19
VAT_EXEMPT_PRODUCT_CODES=103040

# App URL (used for email links, password reset, etc.)
APP_URL=https://premiumfitness-api.nutramerican.com

# SMTP (phpmailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="Your App"
MAIL_ENCRYPTION=tls


# Sap API configuration
SAP_API_URL=https://elitenutapp.com/infoclient
SAP_API_KEY=change-me

# SMS API (Relax Global)
SMS_API_URL=https://backend.relax.global/api/sms/
SMS_API_TOKEN=change-me

# Servientrega API
SERVIENTREGA_API_URL=https://customshirts.nutramerican.com/api/camiseta/consultar-guia
SERVIENTREGA_AUTH_TOKEN=change-me

# ========================================
# Payment Gateways
# ========================================

# --- Sistecrédito (Credinet) ---
SISTECREDITO_URL_CREATE_ORDER=https://api.credinet.co/pay/create
SISTECREDITO_URL_QUERY_TRANSACTION=https://api.credinet.co/pay/GetTransactionResponse
SISTECREDITO_SUBSCRIPTION_KEY=change-me
SISTECREDITO_APPLICATION_KEY=change-me
SISTECREDITO_APPLICATION_TOKEN=change-me
SISTECREDITO_URL_RESPONSE=https://midominio.com/response/sistecredito
SISTECREDITO_URL_CONFIRMATION=https://midominio.com/api/payment-gateway/webhook/sistecredito
SISTECREDITO_SANDBOX_ACTIVE=false

# --- Addi ---
ADDI_AUDIENCE=https://api.addi.com
ADDI_URL_TOKEN=https://auth.addi.com/oauth/token
ADDI_URL_REDIRECTION=https://api.addi.com/v1/online-applications
ADDI_CLIENT_ID=change-me
ADDI_CLIENT_SECRET=change-me
ADDI_GRANT_TYPE=client_credentials
ADDI_URL_CALLBACK=https://midominio.com/api/payment-gateway/webhook/addi
ADDI_URL_REDIRECT=https://midominio.com/response/addi

# --- Bold ---
BOLD_IDENTITY_KEY=change-me
BOLD_SECRET_KEY=change-me
BOLD_URL_NOTIFICATIONS=https://integrations.api.bold.co/payments/webhook/notifications
BOLD_URL_RESPONSE=https://midominio.com/response/bold

# --- Compartidas Payment Gateway ---
PAYMENT_GATEWAY_TIMEOUT_SECONDS=20
PAYMENT_GATEWAY_SPA_RETURN_URL=https://midominio.com/user/checkout/result

# --- Socket gateway (socket.elitenutapp.com) ---
# SOCKET_NOTIFICATION_URL  = host base del gateway (sin path)
# SOCKET_NOTIFICATION_TOKEN = x-project-key del proyecto cliente (alias SOCKET_GATEWAY_KEY_CLIENT)
# Proyectos en GATEWAY_PROJECTS del gateway (spec integraciones/03): `premiumfitness` (app web: avisos de
# pago, SAP, guía y cancelación a cada cliente) y `premiumfitness-admin` (avisos a los agentes).
SOCKET_NOTIFICATION_URL=https://socket.elitenutapp.com
SOCKET_NOTIFICATION_TOKEN=change-me
SOCKET_GATEWAY_PROJECT_ID_CLIENT=premiumfitness
SOCKET_GATEWAY_PROJECT_ID_ADMIN=premiumfitness-admin
SOCKET_GATEWAY_KEY_ADMIN=change-me

# --- Cron Job ---
CRON_JOB_TOKEN=change-me-use-a-long-random-token
CRON_JOB_PAYMENT_EVENTS_URL=https://midominio.com/api/cron-job/payment-event-jobs/process

# Tienda pública — TTL del caché de datos en servidor (segundos)
STORE_CACHE_TTL=3600

# Acceso a la app de dietas (spec integraciones/02). La meta es provisional.
DIET_ACCESS_POINTS_GOAL=249000
DIET_ACCESS_POINTS_COST=50000
DIET_FREE_DAYS=30
# La presenta el backend de dietas en X-Api-Key; mínimo 32 caracteres
DIET_ACCESS_API_KEY=change-this-to-a-random-key-of-at-least-32-chars
DIET_ACCESS_RENEW_URL=https://premiumfitness.nutramerican.com/coach/dietas

# Pago de la comisión (spec negocio/05): día de pago y qué hacer si no es hábil (next|previous)
COMMISSION_PAYMENT_DAY=4
COMMISSION_PAYMENT_SHIFT=next
# Festivos AAAA-MM-DD separados por coma; actualizar cada año
NON_BUSINESS_DAYS=2026-11-16,2026-12-08,2026-12-25,2027-01-01,2027-01-11,2027-03-22,2027-03-25,2027-03-26,2027-05-01,2027-05-10,2027-05-31,2027-06-07,2027-07-05,2027-07-20,2027-08-07,2027-08-16,2027-10-18,2027-11-01,2027-11-15,2027-12-08,2027-12-25
COMMISSION_REPORT_RECIPIENTS=financiero@dominio.com
REPORTS_STORAGE_PATH=storage/private/reports
RECEIPTS_STORAGE_PATH=storage/private/receipts

# Admin: base de los enlaces de los correos a financiero
ADMIN_APP_URL=https://premiumfitness-admin.nutramerican.com

# Notificaciones push con FCM HTTP v1 (spec integraciones/01). Sin el archivo de la cuenta de
# servicio, las notificaciones quedan en cola y no se envían.
FIREBASE_PROJECT_ID=premiumfitness-12ca6
FIREBASE_CREDENTIALS_PATH=storage/private/firebase-fcm-sender.json
PUSH_MAX_ATTEMPTS=5
PUSH_EXPIRY_NOTICE_DAYS=7

# Cargos de tb_empleados que gestionan entrenadores, estrategias, el cierre y los ajustes (por confirmar)
ADMIN_MANAGER_ROLES="ROOT,GERENTE COMERCIAL,ADMINISTRADOR"
