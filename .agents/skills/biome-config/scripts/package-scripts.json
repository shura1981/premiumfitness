{
    "_comment": "Añade estos scripts a tu package.json en la sección 'scripts'. Ajusta las carpetas (./src ./tests) según tu proyecto.",
    "devDependencies": {
        "@biomejs/biome": "^2.3.4"
    },
    "scripts": {
        "check": "npx @biomejs/biome check ./src ./tests",
        "check:fix": "npx @biomejs/biome check --write ./src ./tests",
        "format": "npx @biomejs/biome format --write ./src ./tests"
    }
}