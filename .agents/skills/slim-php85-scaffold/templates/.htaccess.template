AddHandler application/x-httpd-php85 .php
RewriteEngine On

##  Quitar www. y redirigir a la versión sin www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

##  Redirección http a https
RewriteCond %{HTTPS} !=on
RewriteRule ^/?(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Quitar barra lateral al final de la ruta
# RewriteRule ^(.*)/$ /$1 [L,R=301]

<IfModule mod_headers.c>
# Oculta la cabecera X-Powered-By para mejorar la seguridad
Header unset X-Powered-By

# Establece la cabecera CORS para cada origen permitido
SetEnvIf Origin "^http://localhost$" AccessControlAllowOrigin=http://localhost
# SetEnvIf Origin "^https://yourdomain.com$" AccessControlAllowOrigin=https://yourdomain.com
# SetEnvIf Origin "^https://www.yourdomain.com$" AccessControlAllowOrigin=https://www.yourdomain.com

# Aplica las cabeceras CORS a los archivos estáticos, de imagen y video
<FilesMatch "\.(json|css|js|png|jpg|jpeg|gif|svg|ico|mp4|webm|webp)$">
    Header set Access-Control-Allow-Origin "%{AccessControlAllowOrigin}e" env=AccessControlAllowOrigin
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, Content-Type, Accept"
</FilesMatch>
</IfModule>


##  SPA Angular / React / Vue — servir assets estáticos desde una subcarpeta (ej. dist/ o spa/app/)
##  Ejemplo para Angular en /profile: /profile/main-abc.js → dist/main-abc.js (Apache lo sirve directo)
# RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
# RewriteRule ^profile/(.+)$ dist/$1 [L]

##  Si no es un directorio ni un archivo existente, redirigir a index.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
