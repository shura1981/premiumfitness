<?php

declare(strict_types=1);

namespace App\Infrastructure\Controllers;

use Psr\Http\Message\ResponseInterface as Response;
use Psr\Http\Message\ServerRequestInterface as Request;
use RuntimeException;

/**
 * Controlador genérico para servir aplicaciones SPA (Angular / React / Vue).
 *
 * Cómo funciona con Apache + Slim:
 *   1. El request llega a Apache. Si el archivo físico existe (main.abc.js, styles.css)
 *      Apache lo sirve directamente — sin pasar por PHP.
 *   2. Si no existe (ruta SPA como /app/dashboard), el .htaccess lo reescribe a index.php.
 *   3. Slim captura la ruta catch-all y este controlador devuelve el index.html del SPA.
 *
 * El SPA recibe el HTML, carga sus assets (que Apache sirve directamente),
 * y el router del frontend toma el control desde ese punto.
 *
 * Estructura de carpetas recomendada:
 *   spa/
 *     app/        ← ng build --output-path=spa/app  (Angular)
 *     admin/      ← otro SPA si es necesario
 *
 * Registro en app/Routes/WebRoute.php:
 *   $app->get('/app[/{path:.*}]', new SpaController(__DIR__ . '/../../spa/app'));
 *   $app->get('/admin[/{path:.*}]', new SpaController(__DIR__ . '/../../spa/admin'));
 */
class SpaController
{
    private string $indexFile;

    public function __construct(string $spaDirectory)
    {
        $this->indexFile = rtrim($spaDirectory, '/') . '/index.html';
    }

    public function __invoke(Request $request, Response $response): Response
    {
        if (!is_file($this->indexFile)) {
            throw new RuntimeException(
                'SPA index.html not found. Build the frontend first. Expected: ' . $this->indexFile
            );
        }

        $html = file_get_contents($this->indexFile);

        $response->getBody()->write($html);

        return $response
            ->withHeader('Content-Type', 'text/html; charset=utf-8')
            ->withHeader('Cache-Control', 'no-cache, no-store, must-revalidate')
            ->withHeader('X-Frame-Options', 'SAMEORIGIN');
    }
}
