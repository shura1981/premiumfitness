<?php

declare(strict_types=1);

namespace App\Infrastructure\Controllers;

use App\Infrastructure\Logger\LoggerService;
use Psr\Http\Message\ResponseInterface as Response;
use Psr\Http\Message\ServerRequestInterface as Request;

/**
 * Controlador para servir archivos estáticos protegidos mediante API key.
 * Soporta video, imagen y JSON con streaming seguro y logging integrado.
 *
 * REGISTRAR rutas en app/Routes/ResourceRoute.php:
 *   $app->get('/media/video', [FileController::class, 'serveVideo']);
 *   $app->get('/media/image', [FileController::class, 'serveImage']);
 *   $app->get('/media/json',  [FileController::class, 'serveJson']);
 *
 * ACCESO mediante query param:
 *   GET /media/video?key=mi_clave_secreta
 *   GET /media/json?key=mi_clave_secreta
 *
 * Recibe la API key desde AppConfig para no leer $_ENV directamente:
 *   new FileController($config->mediaApiKey)
 *
 * Para servir archivos distintos:
 *   - Cambiar las constantes FILE_* según tu proyecto, o
 *   - Añadir nuevos métodos públicos que llamen a stream() con la ruta deseada:
 *       public function serveManifest(Request $r, Response $res): Response {
 *           return $this->stream($r, $res, 'public/manifest.json', 'application/json');
 *       }
 */
class FileController
{
    // ─── Rutas de archivos ─────────────────────────────────────────────────────
    private const FILE_VIDEO = 'public/videos/demo.mp4';
    private const FILE_IMAGE = 'public/img/photo.webp';
    private const FILE_JSON  = 'public/json/data.json';

    public function __construct(private readonly string $apiKey) {}

    // ─── Rutas públicas ────────────────────────────────────────────────────────

    public function serveVideo(Request $request, Response $response): Response
    {
        return $this->stream($request, $response, self::FILE_VIDEO);
    }

    public function serveImage(Request $request, Response $response): Response
    {
        return $this->stream($request, $response, self::FILE_IMAGE);
    }

    public function serveJson(Request $request, Response $response): Response
    {
        return $this->stream(
            $request,
            $response,
            self::FILE_JSON,
            'application/json; charset=UTF-8'
        );
    }

    // ─── Internals ─────────────────────────────────────────────────────────────

    private function stream(
        Request  $request,
        Response $response,
        string   $filepath,
        ?string  $contentType = null,
    ): Response {
        if (!$this->isAuthorized($request)) {
            $response->getBody()->write(
                json_encode(['error' => 'Unauthorized'], JSON_THROW_ON_ERROR)
            );
            return $response
                ->withHeader('Content-Type', 'application/json')
                ->withStatus(401);
        }

        if (!is_file($filepath)) {
            LoggerService::warning('Media file not found', ['path' => $filepath]);
            $response->getBody()->write(
                json_encode(['error' => 'Not found'], JSON_THROW_ON_ERROR)
            );
            return $response
                ->withHeader('Content-Type', 'application/json')
                ->withStatus(404);
        }

        $handle = fopen($filepath, 'rb');

        if ($handle === false) {
            LoggerService::error('Cannot open file for streaming', ['path' => $filepath]);
            $response->getBody()->write(
                json_encode(['error' => 'Internal error'], JSON_THROW_ON_ERROR)
            );
            return $response
                ->withHeader('Content-Type', 'application/json')
                ->withStatus(500);
        }

        $type    = $contentType ?? (mime_content_type($filepath) ?: 'application/octet-stream');
        $content = (string) stream_get_contents($handle);
        fclose($handle);

        $response->getBody()->write($content);

        return $response
            ->withHeader('Content-Type', $type)
            ->withHeader('Content-Length', (string) strlen($content));
    }

    /**
     * Valida la API key usando comparación en tiempo constante para
     * prevenir ataques de timing sobre la clave secreta.
     */
    private function isAuthorized(Request $request): bool
    {
        $key = (string) ($request->getQueryParams()['key'] ?? '');

        return $this->apiKey !== '' && hash_equals($this->apiKey, $key);
    }
}
