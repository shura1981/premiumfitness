AddHandler application/x-httpd-php85 .php
RewriteEngine On

# Límites de subida de archivos (imágenes de productos)
php_value upload_max_filesize 20M
php_value post_max_size 25M

##  Quitar www. y redirigir a la versión sin www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

##  Redirección http a https
RewriteCond %{HTTPS} !=on
RewriteRule ^/?(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Quitar barra lateral al final de la ruta
# RewriteRule ^(.*)/$ /$1 [L,R=301]

<IfModule mod_headers.c>
# Oculta la cabecera X-Powered-By para mejorar la seguridad
Header unset X-Powered-By

# Establece la cabecera CORS para cada origen permitido
SetEnvIf Origin "^http://localhost$" AccessControlAllowOrigin=http://localhost
# SetEnvIf Origin "^https://yourdomain.com$" AccessControlAllowOrigin=https://yourdomain.com
# SetEnvIf Origin "^https://www.yourdomain.com$" AccessControlAllowOrigin=https://www.yourdomain.com

# Aplica las cabeceras CORS a los archivos estáticos, de imagen y video
<FilesMatch "\.(json|css|js|png|jpg|jpeg|gif|svg|ico|mp4|webm|webp)$">
    Header set Access-Control-Allow-Origin "%{AccessControlAllowOrigin}e" env=AccessControlAllowOrigin
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, Content-Type, Accept"
</FilesMatch>
</IfModule>


##  Ficheros sensibles de la raíz — nunca servir por web
<FilesMatch "^(composer\.(json|lock)|phpunit\.xml|\.env.*|.*\.md)$">
    Require all denied
</FilesMatch>

##  Directorios internos — se leen desde disco por PHP, nunca por URL.
##  `storage/` guarda credenciales, reportes y comprobantes; `docs/`, `specs/` y `tests/` no son parte de la API.
##  (assets/ queda fuera: debe seguir siendo público)
RewriteRule ^(\.agents|\.claude|\.git|app|cache|cron-jobs|docker|docs|load|logs|scripts|specs|src|storage|temp|tests|vendor|views)(/|$) - [F,L]

##  Las apps Angular (web y admin) no se sirven desde aquí: van en sus subdominios (spec arquitectura/02).

##  Si no es un directorio ni un archivo existente, redirigir a index.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
